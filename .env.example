# Copy to .env and adjust. All values have working defaults — the app runs with an empty .env.

# URL of the backend API as seen from the user's BROWSER (used by the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Directory where the backend stores sqlite DB, uploads and model artifacts
MLUTION_DATA_DIR=./data

# --- Optional LLM integration (narrative text only, never metrics) ---
# If unset, Mlution uses deterministic template-based explanations.
# Any OpenAI-compatible endpoint works.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
